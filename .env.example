APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# === LOKAL (Docker) — WAJIB DIUBAH SAAT DEPLOY KE HOSTING ===
# DB_HOST=mysql adalah nama service di docker-compose.yml, hanya bisa di-resolve
# dari dalam jaringan Docker. Di production (tanpa Docker) ganti ke host/IP server DB.
#
# Production:  DB_HOST=<host-atau-ip-server-mysql>
#              DB_PORT=3306
#              FORWARD_DB_PORT dihapus / diabaikan (khusus Docker)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hris_api
DB_USERNAME=admin
DB_PASSWORD=secret123

# Khusus Docker lokal: port MySQL container yang dipetakan ke mesin host,
# supaya bisa dibuka dari DBeaver/TablePlus di 127.0.0.1:<port>.
# Ubah bila 3306 di host Anda sudah terpakai. Tidak ada artinya di production.
FORWARD_DB_PORT=3306
DB_ROOT_PASSWORD=rootpass

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Sengaja "database", bukan "redis": driver ini jalan di mana saja tanpa service
# tambahan, jadi aman dibawa ke hosting non-Docker. Butuh tabel `cache` (dari migrasi).
CACHE_STORE=database
CACHE_PREFIX=hris_cache

MEMCACHED_HOST=127.0.0.1

# === LOKAL (Docker) — WAJIB DIUBAH SAAT DEPLOY KE HOSTING ===
# REDIS_HOST=redis adalah nama service Docker. Di production ganti ke host server Redis,
# atau abaikan seluruh blok ini bila hosting tidak menyediakan Redis
# (CACHE_STORE=database di atas sudah cukup, tidak butuh Redis sama sekali).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# === LOKAL (Docker) — WAJIB DIUBAH SAAT DEPLOY KE HOSTING ===
# MEILISEARCH_HOST memakai nama service Docker. Di production ganti ke URL server
# Meilisearch, atau set SCOUT_DRIVER=collection / database bila tidak memakai Meilisearch.
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey123

# Khusus Docker lokal: port phpmyadmin di mesin host. Ubah bila 8080 sudah terpakai.
FORWARD_PHPMYADMIN_PORT=8080
